# OmindOS Navigation v0.1 runtime image
# Multi-stage build: source stays in builder; final image receives install artifacts only.
ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base-jammy AS builder
SHELL ["/bin/bash","-lc"]
ARG ROS_DISTRO
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions python3-rosdep \
    libeigen3-dev libpcl-dev \
    ros-${ROS_DISTRO}-geometry-msgs ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-tf2 ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-pcl-conversions && rm -rf /var/lib/apt/lists/*
WORKDIR /ws
COPY src ./src
RUN source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --merge-install --install-base /opt/omindos/navigation

FROM ros:${ROS_DISTRO}-ros-base-jammy AS runtime
SHELL ["/bin/bash","-lc"]
ARG ROS_DISTRO
RUN apt-get update && apt-get install -y --no-install-recommends \
    libeigen3-dev libpcl-dev \
    ros-${ROS_DISTRO}-geometry-msgs ros-${ROS_DISTRO}-nav-msgs \
    ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-std-msgs \
    ros-${ROS_DISTRO}-tf2 ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-pcl-conversions && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/omindos/navigation /opt/omindos/navigation
COPY THIRD_PARTY_NOTICES.md /opt/omindos/THIRD_PARTY_NOTICES.md
COPY runtime/entrypoint.sh /omindos-entrypoint.sh
RUN chmod +x /omindos-entrypoint.sh
ENV OMINDOS_NAVIGATION_VERSION=0.1
ENTRYPOINT ["/omindos-entrypoint.sh"]
CMD ["bash"]
