<?xml version="1.0"?>
<launch>
  <!-- Sensor- and platform-neutral navigation entry point.
       Required external contract: map -> robot_frame TF and a traversable PCD.
       The robot adapter subscribes to /cmd_vel outside this launch. -->

  <arg name="start_static_tf" default="false" />
  <arg name="start_map_publisher" default="false" />
  <arg name="start_planner" default="true" />
  <arg name="start_bezier" default="true" />
  <arg name="start_nmpc" default="true" />
  <arg name="start_obstacle_processor" default="false" />
  <arg name="start_rviz" default="true" />

  <arg name="map_frame" default="map" />
  <arg name="robot_frame" default="base_link" />
  <arg name="lidar_frame" default="lidar" />
  <arg name="lidar_topic" default="/points" />
  <arg name="world_map_topic" default="/map" />

  <arg name="pcd_path" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/traversable/traversable_areas.pcd" />
  <arg name="static_map_path" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/point_cloud/scans.pcd" />
  <arg name="casadi_lib_path" default="$(optenv CASADI_LIB_PATH /opt/casadi/lib)" />

  <arg name="safe_margin" default="0.20" />
  <arg name="voxel_leaf" default="0.20" />
  <arg name="robot_height" default="0.60" />
  <arg name="enable_headroom_check" default="false" />
  <arg name="edt_xy_expand" default="1.0" />
  <arg name="edt_z_thickness" default="3" />
  <arg name="step_size" default="0.5" />
  <arg name="max_nodes" default="8000" />
  <arg name="k_neigh" default="30" />
  <arg name="max_slope_deg" default="35" />
  <arg name="start_in_auto" default="false" />

  <!-- Simulation/test only. A real localization source must publish this TF. -->
  <node if="$(arg start_static_tf)" pkg="tf2_ros" type="static_transform_publisher"
        name="static_map_to_robot"
        args="0 0 0 0 0 0 1 $(arg map_frame) $(arg robot_frame)" />

  <include if="$(arg start_map_publisher)" file="$(find map_publisher)/launch/map_publisher.launch">
    <arg name="map_path" value="$(arg static_map_path)" />
    <arg name="map_frame_id" value="$(arg map_frame)" />
  </include>

  <node if="$(arg start_planner)" pkg="planning_3d" type="planning_3d_PRM_node"
        name="planning_3d_PRM_node" output="screen">
    <param name="pcd_path" value="$(arg pcd_path)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="robot_frame" value="$(arg robot_frame)" />
    <param name="safe_margin" value="$(arg safe_margin)" />
    <param name="voxel_leaf" value="$(arg voxel_leaf)" />
    <param name="robot_height" value="$(arg robot_height)" />
    <param name="enable_headroom_check" value="$(arg enable_headroom_check)" />
    <param name="edt_xy_expand" value="$(arg edt_xy_expand)" />
    <param name="edt_z_thickness" value="$(arg edt_z_thickness)" />
    <param name="step_size" value="$(arg step_size)" />
    <param name="max_nodes" value="$(arg max_nodes)" />
    <param name="k_neigh" value="$(arg k_neigh)" />
    <param name="max_slope_deg" value="$(arg max_slope_deg)" />
    <param name="use_soft_penalty" value="false" />
    <param name="use_clearance_penalty" value="true" />
    <param name="clearance_penalty_weight" value="22750.0" />
    <param name="clearance_penalty_scale" value="0.3" />
    <param name="auto_replan" value="true" />
    <param name="replan_frequency" value="1.0" />
    <param name="obstacle_block_radius" value="0.0" />
    <param name="pos_tolerance" value="0.50" />
    <param name="pos_tolerance_exit" value="1.00" />
    <param name="yaw_tolerance" value="0.14" />
  </node>

  <include if="$(arg start_bezier)" file="$(find bezier_path_optimizer)/launch/bezier_path_optimizer.launch" />

  <include if="$(arg start_obstacle_processor)" file="$(find obstacle_processor)/launch/obstacle_processor.launch">
    <arg name="lidar_topic" value="$(arg lidar_topic)" />
    <arg name="world_map_topic" value="$(arg world_map_topic)" />
    <arg name="lidar_frame_id" value="$(arg lidar_frame)" />
    <arg name="map_frame_id" value="$(arg map_frame)" />
    <arg name="base_frame_id" value="$(arg robot_frame)" />
  </include>

  <include if="$(arg start_nmpc)" file="$(find nmpc_planner)/launch/nmpc_controller.launch">
    <arg name="casadi_lib_path" value="$(arg casadi_lib_path)" />
    <arg name="start_in_auto" value="$(arg start_in_auto)" />
    <arg name="start_obstacle_processor" value="false" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="robot_frame" value="$(arg robot_frame)" />
  </include>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find planning_3d)/rviz/default.rviz" />
</launch>
