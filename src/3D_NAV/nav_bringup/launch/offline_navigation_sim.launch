<?xml version="1.0"?>
<launch>
  <!-- Offline navigation: static map + kinematic base, with no sensor or hardware bridge. -->

  <arg name="pcd_path" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/traversable/traversable_areas.pcd" />
  <arg name="static_map_path" default="$(arg pcd_path)" />
  <arg name="map_frame" default="map" />
  <arg name="robot_frame" default="base_link" />
  <arg name="start_rviz" default="true" />
  <arg name="start_in_auto" default="true" />
  <arg name="initial_x" default="0.0" />
  <arg name="initial_y" default="0.0" />
  <arg name="initial_z" default="0.0" />
  <arg name="initial_yaw" default="0.0" />
  <arg name="motion_mode" default="path" />
  <arg name="path_following_speed" default="0.35" />
  <arg name="casadi_lib_path" default="$(optenv CASADI_LIB_PATH /opt/casadi/lib)" />

  <include file="$(find map_publisher)/launch/map_publisher.launch">
    <arg name="map_path" value="$(arg static_map_path)" />
    <arg name="map_frame_id" value="$(arg map_frame)" />
    <arg name="voxel_size" value="0.10" />
    <arg name="publish_rate" value="0" />
    <arg name="latch" value="true" />
  </include>

  <node pkg="nav_bringup" type="offline_base_sim.py" name="offline_base_sim" output="screen">
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="base_frame" value="$(arg robot_frame)" />
    <param name="initial_x" value="$(arg initial_x)" />
    <param name="initial_y" value="$(arg initial_y)" />
    <param name="initial_z" value="$(arg initial_z)" />
    <param name="initial_yaw" value="$(arg initial_yaw)" />
    <param name="initialpose_uses_z" value="false" />
    <param name="motion_mode" value="$(arg motion_mode)" />
    <param name="path_topic" value="/path_smooth" />
    <param name="path_following_speed" value="$(arg path_following_speed)" />
    <param name="cmd_timeout" value="0.35" />
    <param name="max_linear_velocity" value="0.9" />
    <param name="max_angular_velocity" value="1.4" />
  </node>

  <node pkg="planning_3d" type="planning_3d_PRM_node" name="planning_3d_PRM_node" output="screen">
    <param name="pcd_path" value="$(arg pcd_path)" />
    <param name="map_frame" value="$(arg map_frame)" />
    <param name="robot_frame" value="$(arg robot_frame)" />
    <param name="edt_xy_expand" value="1.0" />
    <param name="edt_z_thickness" value="3" />
    <param name="robot_height" value="1.0" />
    <param name="enable_headroom_check" value="false" />
    <param name="safe_margin" value="0.10" />
    <param name="use_soft_penalty" value="false" />
    <param name="use_clearance_penalty" value="true" />
    <param name="clearance_penalty_weight" value="22750.0" />
    <param name="clearance_penalty_scale" value="0.3" />
    <param name="step_size" value="0.5" />
    <param name="max_nodes" value="8000" />
    <param name="k_neigh" value="30" />
    <param name="max_slope_deg" value="45" />
    <param name="voxel_leaf" value="0.20" />
    <param name="auto_replan" value="true" />
    <param name="replan_frequency" value="1.0" />
    <param name="obstacle_block_radius" value="0.0" />
    <param name="pos_tolerance" value="0.50" />
    <param name="pos_tolerance_exit" value="2.00" />
    <param name="yaw_tolerance" value="0.14" />
  </node>

  <include file="$(find bezier_path_optimizer)/launch/bezier_path_optimizer.launch" />

  <include file="$(find nmpc_planner)/launch/nmpc_controller.launch">
    <arg name="casadi_lib_path" value="$(arg casadi_lib_path)" />
    <arg name="start_in_auto" value="$(arg start_in_auto)" />
    <arg name="start_obstacle_processor" value="false" />
    <arg name="map_frame" value="$(arg map_frame)" />
    <arg name="robot_frame" value="$(arg robot_frame)" />
  </include>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find planning_3d)/rviz/default.rviz" />
</launch>
