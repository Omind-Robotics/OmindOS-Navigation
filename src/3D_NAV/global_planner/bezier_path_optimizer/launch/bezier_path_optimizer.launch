<launch>
  <!-- 五阶贝塞尔曲线平滑器 -->
  <node pkg="bezier_path_optimizer" type="bezier_path_optimizer_node"
        name="bezier_path_optimizer" output="screen">

    <!-- 订阅话题：必须与 PRM 输出一致 -->
    <remap from="/planned_path" to="/planning_3d_PRM_node/planned_path"/>

    <!-- 采样密度 -->
    <param name="sample_rate" value="20"/>   <!-- 每段贝塞尔输出 20+1 点 -->

    <!-- Q1 辅助点尺度 -->
    <param name="q1_scale"      value="0.3"/>
    <param name="q1_max_ratio"  value="1.0"/>

    <!-- 末端姿态策略 -->
    <param name="end_strategy" value="keep_original"/>  <!-- same_as_prev | keep_original -->

    <!-- 是否自动计算四元数 -->
    <param name="enable_orientation" value="true"/>
  </node>
</launch>