<launch>
    <!-- Map Publisher Node for Simulation -->

    <!-- PCD map file path -->
    <arg name="map_path" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/point_cloud/scans.pcd" />

    <!-- Voxel downsampling size (meters), set to 0 to disable -->
    <arg name="voxel_size" default="0.1" />

    <!-- Map frame ID -->
    <arg name="map_frame_id" default="map" />

    <!-- Publish rate (Hz), set to 0 or negative to publish only once -->
    <arg name="publish_rate" default="0" />

    <!-- Latch mode: true = new subscribers receive the last published message -->
    <arg name="latch" default="true" />

    <!-- Map Publisher Node -->
    <node pkg="map_publisher" type="map_publisher_node" name="map_publisher_node" output="screen">
        <param name="map_path" value="$(arg map_path)" />
        <param name="voxel_size" value="$(arg voxel_size)" />
        <param name="map_frame_id" value="$(arg map_frame_id)" />
        <param name="publish_rate" value="$(arg publish_rate)" />
        <param name="latch" value="$(arg latch)" />
    </node>

</launch>
