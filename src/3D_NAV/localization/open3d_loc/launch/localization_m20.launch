<?xml version="1.0"?>
<launch>
  <arg name="map_path" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/point_cloud/scans.pcd" />
  <arg name="config_file" default="$(find open3d_loc)/config/loc_param_m20.yaml" />

  <!-- open3d_loc publishes map->odom and map->motion_link. These links connect
       FAST-LIO's camera_init/body branch without assigning base_link twice. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="m20_odom_to_camera_init"
        args="0 0 0 0 0 0 1 odom camera_init" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="m20_base_link_to_imu_link"
        args="0 0 0 0 0 0 1 base_link imu_link" />
  <node pkg="tf2_ros" type="static_transform_publisher" name="m20_motion_link_to_base_link"
        args="0 0 0 0 0 0 1 motion_link base_link" />

  <node pkg="open3d_loc" type="global_localization_node"
        name="global_localization_node" output="screen">
    <rosparam command="load" file="$(arg config_file)" />
    <param name="path_map" type="string" value="$(arg map_path)" />
    <remap from="/Odometry" to="/Odometry_loc" />
    <remap from="/cloud_registered" to="/cloud_registered_1" />
  </node>

  <param name="use_sim_time" value="false" />
</launch>
