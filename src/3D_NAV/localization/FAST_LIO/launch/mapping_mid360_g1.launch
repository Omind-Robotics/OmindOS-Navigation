<launch>
<!-- Launch file for Livox MID360 LiDAR -->

	<arg name="start_driver" default="true" />
	<arg name="rviz" default="true" />
	<arg name="pcd_save_en" default="true" />
	<arg name="pcd_save_interval" default="-1" />
	<arg name="pcd_output_dir" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/point_cloud" />
	<arg name="record_trajectory" default="true" />
	<arg name="trajectory_output_file" default="$(optenv NAV3D_DATA_ROOT /tmp/nav3d_data)/trace_data/mapping_trajectory.txt" />
	<arg name="trajectory_min_interval" default="0.1" />
	<arg name="trajectory_min_distance" default="0.02" />

	<include if="$(arg start_driver)" file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
		<arg name="xfer_format" value="1" />
		<arg name="rviz_enable" value="false" />
		<arg name="rosbag_enable" value="false" />
	</include>

	<rosparam command="load" file="$(find fast_lio)/config/mid360_g1.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="1" />
	<param name="pcd_save/pcd_save_en" type="bool" value="$(arg pcd_save_en)" />
	<param name="pcd_save/interval" type="int" value="$(arg pcd_save_interval)" />
	<param name="pcd_save/output_dir" type="string" value="$(arg pcd_output_dir)" />
    <node pkg="fast_lio" type="fastlio_mapping" name="fast_lio_node" output="screen" /> 
	<param name="use_sim_time" value="false" />

	<node if="$(arg record_trajectory)" pkg="fast_lio" type="mapping_trajectory_recorder.py"
	      name="mapping_trajectory_recorder" output="screen">
		<param name="odom_topic" value="/Odometry_loc" />
		<param name="output_file" value="$(arg trajectory_output_file)" />
		<param name="min_interval" value="$(arg trajectory_min_interval)" />
		<param name="min_distance" value="$(arg trajectory_min_distance)" />
		<param name="append" value="false" />
	</node>

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>

</launch>
