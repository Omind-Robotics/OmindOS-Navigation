<?xml version="1.0"?>
<package format="3">
  <name>nmpc_planner_ros2</name>
  <version>0.1.0</version>
  <description>Native ROS 2 wrapper for the original Nav_3d CasADi NMPC planner and controller.</description>
  <maintainer email="user@example.com">Nav3D Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>eigen</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
