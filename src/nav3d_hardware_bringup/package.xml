<?xml version="1.0"?>
<package format="3">
  <name>nav3d_hardware_bringup</name>
  <version>0.1.0</version>
  <description>ROS 2 hardware and offline simulation bringup for Nav_3d.</description>
  <maintainer email="maintainer@example.com">Nav3D Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>planning_3d_ros2</exec_depend>
  <exec_depend>nmpc_planner_ros2</exec_depend>
  <exec_depend>nav3d_native</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_3d_nav_goal_tool_ros2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
