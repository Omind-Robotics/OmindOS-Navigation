Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
      Color: 100; 100; 100
      Alpha: 0.35
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Traversable PCD
      Enabled: true
      Topic:
        Value: /pcd_map
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.04
      Color Transformer: AxisColor
      Axis: Z
      Use Fixed Frame: true
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Min Value: -10
        Max Value: 10
        Value: true
      Alpha: 1
      Selectable: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Safe Centers
      Enabled: false
      Topic:
        Value: /safe_centers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Spheres
      Size (m): 0.12
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Alpha: 0.8
    - Class: rviz_default_plugins/Marker
      Name: PRM Graph
      Enabled: false
      Marker Topic:
        Value: /prm_graph
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/Path
      Name: Planned Path
      Enabled: true
      Topic:
        Value: /planned_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.08
      Color: 255; 85; 0
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: Smooth Path
      Enabled: true
      Topic:
        Value: /path_smooth
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.10
      Color: 0; 255; 80
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: Local Path
      Enabled: true
      Topic:
        Value: /local_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Line Style: Lines
      Line Width: 0.06
      Color: 40; 140; 255
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/Path
      Name: Simulated Path
      Enabled: true
      Topic:
        Value: /simulated_path
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Line Style: Lines
      Line Width: 0.08
      Color: 255; 0; 255
      Alpha: 1
      Buffer Length: 1
      Pose Style: None
    - Class: rviz_default_plugins/Odometry
      Name: Simulated Robot
      Enabled: true
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Shape:
        Value: Arrow
        Color: 255; 255; 0
        Alpha: 1
        Shaft Length: 0.8
        Shaft Radius: 0.08
        Head Length: 0.25
        Head Radius: 0.15
      Keep: 1
  Enabled: true
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: nav3d_rviz_plugins/Goal3DTool
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 1
        Y: 1
        Z: 1.5
      Pitch: 0.75
      Yaw: 4.7
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
  X: 100
  Y: 80
