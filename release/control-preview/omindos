#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ "$(uname -m)" != x86_64 ]; then
    echo 'This preview requires Linux x86_64; Jetson ARM64 is not included.' >&2
    exit 2
fi
command -v docker >/dev/null 2>&1 || { echo 'Please install Docker Engine first.' >&2; exit 2; }
image='omindos/control-preview:0.2.0-preview.5'
image_known() {
    actual=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null || true)
    [ -n "$actual" ] && grep -Fqx -- "$actual" IMAGE_ID.txt
}
if ! image_known; then
    sha256sum -c SHA256SUMS-image.txt
    docker load -i omindos-control-preview-0.2.0-preview.5-linux-amd64.image.tar.gz
fi
image_known || { echo 'Image identity mismatch.' >&2; exit 2; }
mkdir -p data
if [ "$#" -eq 0 ]; then set -- workbench; fi
case "$1" in
  workbench|parameter-api) set -- "$@" --store /data/profiles ;;
  quadruped) set -- "$@" --token-file /data/quadruped.token ;;
  quadruped-ros) set -- "$@" --token-file /data/quadruped.token ;;
  validate-dynamics) set -- "$@" --source /opt/omindos/reference --output /data/dynamics.json ;;
esac
exec docker run --rm --init --network host --user "$(id -u):$(id -g)" \
    --cap-drop ALL --security-opt no-new-privileges \
    -e HOME=/tmp -e ROS_LOCALHOST_ONLY=1 -e ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}" \
    -v "$(pwd)/data:/data" "$image" "$@"
